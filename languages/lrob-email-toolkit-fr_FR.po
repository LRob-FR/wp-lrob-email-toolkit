#. Plugin Name of the plugin
msgid "LRob - Email Toolkit"
msgstr "LRob - Email Toolkit"

#. Plugin URI of the plugin
msgid "https://www.lrob.fr/wordpress/plugins/lrob-email-toolkit/"
msgstr "https://www.lrob.fr/wordpress/plugins/lrob-email-toolkit/"

#. Description of the plugin
msgid ""
"All-in-one modular email plugin: SMTP routing, email logging with IMAP "
"\"Save to Sent\" archiving, contact forms, newsletters, and webhook "
"integrations. Each module is independently activatable."
msgstr ""
"Extension email tout-en-un modulaire : routage SMTP, journalisation des "
"emails avec archivage IMAP « Enregistrer dans les Envoyés », formulaires de "
"contact, newsletters et intégrations webhook. Chaque module est activable "
"indépendamment."

#. Author of the plugin
msgid "LRob"
msgstr "LRob"

#. Author URI of the plugin
msgid "https://www.lrob.fr"
msgstr "https://www.lrob.fr"

